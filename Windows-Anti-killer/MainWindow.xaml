<Window
    x:Class="Windows_Anti_killer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Windows-Anti-killer">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Grid Grid.Row="0"
              Padding="24,0"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Windows-Anti-killer"
                           FontSize="20"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Windows Rescue Utility"
                           FontSize="12"
                           Opacity="0.6"/>
            </StackPanel>

            <!-- 防护模式 -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="12">

                <TextBlock x:Name="ProtectionModeText"
                           Text="BASIC PROTECTION"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontWeight="SemiBold"/>

                <ToggleSwitch x:Name="ProtectionModeSwitch"
                              Toggled="ProtectionModeSwitch_Toggled"/>
            </StackPanel>
        </Grid>

        <!-- 主体 -->
        <NavigationView x:Name="MainNavigation"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        SelectionChanged="MainNavigation_SelectionChanged">

            <NavigationView.MenuItems>

                <NavigationViewItem Content="概览"
                                    Tag="Overview">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="进程"
                                    Tag="Processes">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="AllApps"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="系统保护"
                    Tag="SystemProtection">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                  Glyph="&#xE83D;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="日志"
                                    Tag="Logs">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="List"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="设置"
                                    Tag="Settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame"/>

        </NavigationView>

    </Grid>
</Window>